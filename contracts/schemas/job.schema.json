{
  "$defs": {
    "Command": {
      "properties": {
        "client": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Client"
        },
        "db": {
          "title": "Db",
          "type": "string"
        },
        "fy": {
          "title": "Fy",
          "type": "string"
        },
        "industry": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Industry",
          "type": "string"
        },
        "mode": {
          "enum": [
            "run",
            "strategy-only",
            "refresh"
          ],
          "title": "Mode",
          "type": "string"
        },
        "nic_codes": {
          "items": {
            "pattern": "^[0-9]{2,5}$",
            "type": "string"
          },
          "title": "Nic Codes",
          "type": "array"
        },
        "pli": {
          "enum": [
            "OP/OC",
            "OP/OR",
            "GP/Sales"
          ],
          "title": "Pli",
          "type": "string"
        },
        "products": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Products",
          "type": "array"
        },
        "tested_party": {
          "enum": [
            "service",
            "manufacturer",
            "distributor"
          ],
          "title": "Tested Party",
          "type": "string"
        },
        "tp_sales_cr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tp Sales Cr"
        }
      },
      "required": [
        "db",
        "fy",
        "industry",
        "nic_codes",
        "products",
        "client",
        "pli",
        "tp_sales_cr",
        "tested_party",
        "mode"
      ],
      "title": "Command",
      "type": "object"
    }
  },
  "properties": {
    "command": {
      "$ref": "#/$defs/Command"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dest": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Dest",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "inbox",
        "running",
        "enable",
        "stuck",
        "done"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "dest",
    "command",
    "created_at",
    "status"
  ],
  "title": "Job",
  "type": "object"
}
